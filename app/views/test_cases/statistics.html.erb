<h2><%=l(:label_test_case_statistics)%></h2>

<% if @test_cases.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <div class="autoscroll">
    <table id="statistics" class="list issues odd-even sort-by-id sort-desc">
      <thead>
        <tr>
          <th><%=l(:field_user)%></th>
          <th><%=l(:field_count_test_cases)%></th>
          <th><%=l(:field_status_not_run)%></th>
          <th><%=l(:field_status_passed)%></th>
          <th><%=l(:field_status_failed)%></th>
          <th><%=l(:field_status_in_progress)%></th>
          <th><%=l(:field_status_on_hold)%></th>
          <th><%=l(:field_status_not_applicable)%></th>
          <th><%=l(:field_progress_rate)%></th>
        </tr>
      </thead>
      <tbody>
        <% @test_cases.each do |user_id, stats| %>
        <tr>
          <td class="user"><%= link_to User.find(user_id).name, "/users/#{user_id}" rescue l(:label_none) %></td>
          <td class="test_cases"><%= stats[:count] %></td>
          <td class="count_not_executed"><%= stats[:not_executed] %></td>
          <td class="count_passed"><%= stats[:passed] %></td>
          <td class="count_failed"><%= stats[:failed] %></td>
          <td class="count_in_progress"><%= stats[:in_progress] %></td>
          <td class="count_on_hold"><%= stats[:on_hold] %></td>
          <td class="count_not_applicable"><%= stats[:not_applicable] %></td>
          <td class="progress_rate">
            <% if stats[:count] > 0 %>
              <%= (((stats[:passed] + stats[:failed]) / stats[:count].to_f) * 100).round %>%
            <% else %>
              -
            <% end %>
          </td>
        </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% content_for :sidebar do %>
  <%= render :partial => 'test_cases/sidebar' %>
<% end %>
